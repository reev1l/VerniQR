# Создайте бота у @BotFather и вставьте токен сюда, в локальный .env.
BOT_TOKEN=
BOT_USERNAME=verniQRbot
# Enable only if Telegram is reachable via the configured Windows HTTPS proxy.
TELEGRAM_USE_WINDOWS_PROXY=0
# HTTPS-адрес сервера без завершающего /; localhost только для разработки.
PUBLIC_URL=http://localhost:8000
# Telegram ID администраторов через запятую. Свой ID можно узнать командой /id.
ADMIN_IDS=
# Замените длинной случайной строкой: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=development-only-change-before-publishing
DATABASE_PATH=data/verniqr.sqlite3
BACKUP_DIR=data/backups
HOST=127.0.0.1
PORT=8000
# Контакт команды для ручной оплаты. URL Telegram, сайта или email.
SUPPORT_CONTACT=Напишите организатору пилота
ACCESS_PRICE_RUB=50
REPORT_IP_LIMIT=10
REPORT_ITEM_LIMIT=5
REPORT_WINDOW_SECONDS=600
